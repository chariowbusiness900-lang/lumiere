{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUMIERE",
  "version": "1.0.0",
  "identifier": "com.lumiere.lecteur",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "LUMIERE — Lecteur Musique", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600, "decorations": false, "transparent": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: https: data: blob:; media-src 'self' asset: https: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "windows": { "nsis": { "displayLanguageSelector": false } }, "icon": ["icons/icon.png"] }
}
